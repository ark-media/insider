{
  "functions": {
    "api/handler.ts": {
      "includeFiles": "{server,shared}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/handler?_path=$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/reconcile-entitlements",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/feed-setup-reminders",
      "schedule": "0 15 * * *"
    }
  ]
}
