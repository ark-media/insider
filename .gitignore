# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.tanstack
*.local
.env
# Deliberately covers .env.example too. Despite the name, that file currently
# holds REAL values (Circle tokens, CHECKOUT_SESSION_SECRET, CIRCLE_SSO_SECRET),
# not placeholders — so it must not be tracked. If you want a committed schema,
# add a separate .env.template with every value stubbed out.
.env.*

# Scratch artifacts — screenshots of signed-in pages, copy extracts. Untracked
# already, but nothing stopped a `git add -A` from sweeping them in.
.tmp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Use bun.lock as the single lockfile
package-lock.json

# Machine-specific workspace overrides
.humanlayer/workspace.local.json
.vercel
