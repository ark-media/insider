# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.tanstack
*.local
.env
# Deliberately a blanket pattern: every .env variant holds real values, and a
# file named .env.example would be ignored too. There is no such file any more.
# If you want a committed schema, name it so this pattern doesn't catch it
# (env.template) and stub out every value.
.env.*

# Scratch artifacts — screenshots of signed-in pages, copy extracts. Untracked
# already, but nothing stopped a `git add -A` from sweeping them in.
.tmp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# pnpm-lock.yaml is the single lockfile (installs are pnpm; bun only runs
# scripts), so neither of the others gets committed.
package-lock.json
bun.lock
bun.lockb

# Agent worktrees: full checkouts of this repo, copied .env files included.
.claude/worktrees/

# Machine-specific workspace overrides
.humanlayer/workspace.local.json
.vercel
