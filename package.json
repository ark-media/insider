    "@stripe/stripe-js": "^9.12.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "@tiptap/react": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "@vercel/speed-insights": "^2.0.0",
    "auth0": "^5.14.0",
    "html-react-parser": "^6.1.5",
    "jose": "^6.2.4",
    "openid-client": "^6.8.4",
    "posthog-js": "^1.407.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "2.17.1",
