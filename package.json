{
  "name": "insider",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.26.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "sanitize-html>htmlparser2": "^9.1.0"
    }
  },
  "scripts": {
    "dev": "vite",
    "routes": "bun run scripts/generate-routes.ts",
    "build": "bun run routes && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "bun test",
    "knip": "knip",
    "migrate": "bun run scripts/migrate.ts",
    "migrate:status": "bun run scripts/migrate.ts status",
    "migrate:create": "bun run scripts/migrate.ts create"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/react": "^10.75.0",
    "@stripe/react-stripe-js": "^6.10.0",
    "@stripe/stripe-js": "^9.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.38",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vercel/speed-insights": "^2.0.0",
    "auth0": "^5.14.0",
    "html-react-parser": "^6.1.7",
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "posthog-js": "^1.433.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "2.17.7",
    "stripe": "22.3.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@happy-dom/global-registrator": "^20.14.5",
    "@tanstack/router-generator": "^1.167.38",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "knip": "^6.36.0",
    "playwright": "1.63.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
