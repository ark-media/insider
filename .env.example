# ============================================================================
# App
# ============================================================================
# Public base URL of this app. Used to build magic-link redirect URLs and to
# validate inbound redirect parameters. Must match the origin you're hitting
# in the browser during development.
APP_BASE_URL=http://localhost:5173

# Secret for signing session cookies and sign-in nonces. Any random string.
# Generate with: openssl rand -hex 32
# If empty, a fresh one is generated at boot and sessions reset on restart.
SESSION_SECRET=

# ============================================================================
# Supporting Cast API v2 (server-side only — do NOT prefix with VITE_)
# ============================================================================
SC_NETWORK_ID=
SC_API_KEY=

# subscription_price_id values for each tier. Find these in
# Admin Console → Subscription Plans → (plan) → Prices.
SC_SUBSCRIPTION_PRICE_ID_MONTHLY=
SC_SUBSCRIPTION_PRICE_ID_YEARLY=

# Dedicated gift prices (6-month and 1-year). Access is truncated by the
# `ends_at` we set at creation — these prices are used as the plan shell so
# gift subscriptions show up cleanly in SC reporting.
SC_SUBSCRIPTION_PRICE_ID_GIFT_6MO=
SC_SUBSCRIPTION_PRICE_ID_GIFT_1YR=

# ============================================================================
# Stripe
# ============================================================================
# Secret key — server-only. Use sk_test_... for sandbox.
STRIPE_SECRET_KEY=

# Webhook signing secret. Run `stripe listen --forward-to \
# http://localhost:5173/api/stripe/webhook` to get one for local dev.
STRIPE_WEBHOOK_SECRET=

# Publishable key — safe to ship to the browser. Must be VITE_-prefixed.
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional recurring Stripe price IDs for the default tiers. If empty, the
# server creates (and caches) a dynamic Price on first checkout.
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_YEARLY=

# ============================================================================
# Auth0 Management API (server-side only — do NOT prefix with VITE_)
# ============================================================================
# M2M application credentials used to create Auth0 users after a successful
# payment. Create an M2M app in the Auth0 dashboard, authorize it for the
# Management API, and grant it the scopes: read:users create:users
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

# Signing secret for the short-lived JWT issued by /api/auth/checkout-session
# so new subscribers are logged in immediately after payment (rather than
# waiting on the password-reset email round-trip). Any random string.
# Generate with: openssl rand -hex 32
CHECKOUT_SESSION_SECRET=

# ============================================================================
# Clerk
# ============================================================================
# Publishable key from https://dashboard.clerk.com/~/api-keys (choose React).
# Safe to ship to the browser. Must be VITE_-prefixed.
VITE_CLERK_PUBLISHABLE_KEY=

# Secret key from https://dashboard.clerk.com/~/api-keys. Server-only.
# When set, every /api/* request (except /api/stripe/webhook and
# /api/sc/callback) requires a valid Clerk session. Leave empty to disable
# the gate.
CLERK_SECRET_KEY=

# ============================================================================
# Preview gate (VITE_-prefixed so Vite embeds it at build time)
# ============================================================================
# When set in production, the site shows a password prompt before rendering.
# Leave empty (or omit) to disable the gate entirely.
VITE_GATE_PASSWORD=

# ============================================================================
# Simplecast playlist embeds (VITE_-prefixed — embedded at build time)
# ============================================================================
# Podcast UUID per public show. Find each one in the Simplecast dashboard
# under Distribution → Embeds → All Episodes. When unset, the show page
# simply omits the playlist player section.
VITE_SIMPLECAST_PODCAST_ID_CALL_ME_BACK=95ea4d0c-35c7-4ac7-a410-7d9f02ee3ded
VITE_SIMPLECAST_PODCAST_ID_FOR_HEAVENS_SAKE=73e4172a-7831-48cf-a6a9-390097bd76d3
VITE_SIMPLECAST_PODCAST_ID_WHATS_YOUR_NUMBER=0f41eccf-6011-4668-9afc-32b71bc38e7b
VITE_SIMPLECAST_PODCAST_ID_ARK_NEWS_DAILY=52dc746a-a19d-4078-87e9-3fef0a1801c6

# Server-only Simplecast API token. Used by /api/simplecast/episodes to
# fetch the real episode catalog. Generate one under Simplecast Account →
# Settings → API. Leave unset in dev to keep the mock catalog.
SIMPLECAST_API_TOKEN=

# ============================================================================
# Circle community (server-side only)
# ============================================================================
# Headless Member API token. Generate one at
# https://app.circle.so/settings/api/tokens with member-read + member-write
# scopes. Used to tag members as subscribers on Stripe webhook events.
CIRCLE_API_TOKEN=

# Community ID — find it in the URL of any admin page in your Circle dashboard.
CIRCLE_COMMUNITY_ID=

# Member tag ID for paid subscribers. Create the tag in Circle admin first
# (Members → Tags → New), then paste its ID here. Use this tag to gate Spaces
# in the Circle admin UI.
CIRCLE_SUBSCRIBER_TAG_ID=

# ============================================================================
# Entitlement reconciliation cron
# ============================================================================
# Shared secret protecting /api/cron/reconcile-entitlements. Vercel attaches
# this as `Authorization: Bearer <CRON_SECRET>` to scheduled invocations.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ============================================================================
# Observability — Sentry, PostHog, Vercel
# ============================================================================
# Sentry DSN — find at https://sentry.io → project → Settings → Client Keys.
# VITE_-prefixed so the browser SDK can read it; the same DSN works
# server-side if you ever add a Node Sentry SDK.
VITE_SENTRY_DSN=

# PostHog project API key (starts with phc_). Settings → Project → API Keys.
# VITE_-prefixed so the browser SDK can read it.
VITE_POSTHOG_KEY=

# PostHog host. Defaults to us.i.posthog.com — set to eu.i.posthog.com if
# your PostHog project is in the EU region.
VITE_POSTHOG_HOST=https://us.i.posthog.com
